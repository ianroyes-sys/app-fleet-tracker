# All optional. Copy to .env.local and fill in what you need.

# App Store Connect API key (Users and Access > Integrations > App Store Connect API, role App Manager).
# When all three are set, scripts/testflight.mjs uses real build upload dates instead of fleet.json dates.
ASC_KEY_ID=
ASC_ISSUER_ID=
# Path to the downloaded .p8 private key, kept outside this repo, e.g. ~/.appstoreconnect/AuthKey_XXXX.p8
ASC_KEY_PATH=

# Where your records live (default ./data; falls back to ./data/example when a file is missing)
FLEET_DATA_DIR=
# Pin "today" (YYYY-MM-DD) for demos and screenshots
DEMO_NOW=
